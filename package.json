{
  "name": "omm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.4",
  "engines": {
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter web dev",
    "build": "bun run --filter '*' build",
    "check": "oxfmt --check && oxlint --deny-warnings && markdownlint-cli2 '**/*.md'",
    "format": "oxfmt --write",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "prepare": "lefthook install",
    "deploy": "scripts/deploy-pages.sh apps/web/dist mystery-omm main"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.13.9",
    "carryctx": "0.5.6",
    "ctxctl": "^0.2.2",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7"
  }
}
