{
  "name": "omm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.4",
  "engines": {
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "baseline:vectojs": "bun run scripts/vectojs-baseline.ts",
    "dev": "bun run --filter '@omm/web' dev",
    "build": "bun run --filter '*' build",
    "check": "oxfmt --check && oxlint --deny-warnings && markdownlint-cli2 '**/*.md'",
    "format": "oxfmt --write",
    "lint": "oxlint --deny-warnings",
    "test": "bun test --path-ignore-patterns='tmp/**'",
    "test:e2e": "bun run scripts/graph-regression-e2e.ts",
    "test:e2e:graph-regression": "bun run scripts/graph-regression-e2e.ts",
    "test:e2e:ui": "bun run scripts/ui-polish-e2e.ts",
    "audit:detectives": "bun scripts/audit-detective-data.ts",
    "publish:database": "bun scripts/publish-database-release.ts",
    "prepare": "lefthook install",
    "deploy": "scripts/deploy-pages.sh apps/web/dist omm main"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.13.9",
    "carryctx": "0.5.6",
    "ctxctl": "^0.2.2",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7"
  }
}
